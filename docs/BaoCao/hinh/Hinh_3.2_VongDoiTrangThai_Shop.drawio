<mxfile host="app.diagrams.net">
  <diagram name="Hinh 3.2 - Vong doi trang thai shop" id="h32">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
                  arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="700"
                  math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="60" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pending" value="PENDING&#10;Chờ duyệt" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Times New Roman;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="active" value="ACTIVE&#10;Đang hoạt động" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Times New Roman;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rejected" value="REJECTED&#10;Hồ sơ bị từ chối" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Times New Roman;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="suspended" value="SUSPENDED&#10;Tạm dừng" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Times New Roman;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="400" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e0" value="Chủ cửa hàng&#10;gửi hồ sơ đăng ký" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontFamily=Times New Roman;fontSize=12;align=left;" edge="1" parent="1" source="start" target="pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="duyệt&#10;(nâng vai USER → VENDOR)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeWidth=2;strokeColor=#2D7600;fontFamily=Times New Roman;fontSize=12;fontColor=#2D7600;verticalAlign=bottom;" edge="1" parent="1" source="pending" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="từ chối&#10;(bắt buộc ghi lý do)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontFamily=Times New Roman;fontSize=12;align=left;" edge="1" parent="1" source="pending" target="rejected">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="110" y="330" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" value="mở lại hồ sơ" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;dashed=1;fontFamily=Times New Roman;fontSize=12;align=right;" edge="1" parent="1" source="rejected" target="pending">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="190" y="330" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e4" value="duyệt&#10;(nâng vai USER → VENDOR)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeWidth=2;strokeColor=#2D7600;fontFamily=Times New Roman;fontSize=12;fontColor=#2D7600;verticalAlign=top;" edge="1" parent="1" source="rejected" target="active">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="390" y="435" /><mxPoint x="390" y="215" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e5" value="tạm dừng&#10;(ghi lý do, vẫn là VENDOR)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontFamily=Times New Roman;fontSize=12;align=left;" edge="1" parent="1" source="active" target="suspended">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="590" y="330" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" value="mở lại" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;dashed=1;fontFamily=Times New Roman;fontSize=12;align=right;" edge="1" parent="1" source="suspended" target="active">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="670" y="330" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note1" value="&lt;b&gt;Nâng vai USER → VENDOR chỉ xảy ra ở bước duyệt.&lt;/b&gt;&#10;Đăng ký xong mà chưa duyệt thì chủ cửa hàng vẫn là USER và không vào được khu /vendor.&#10;Từ chối hoặc tạm dừng đều không đổi vai của chủ cửa hàng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;fontFamily=Times New Roman;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;Mọi chuyển trạng thái khác đều bị chặn, ví dụ:&lt;/b&gt;&#10;• duyệt lại một cửa hàng đang ACTIVE&#10;• từ chối một cửa hàng không ở PENDING&#10;• mở lại một cửa hàng không ở SUSPENDED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;fontFamily=Times New Roman;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="530" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="Manager duyệt một cửa hàng&#10;chưa ai nhận thì nhận luôn&#10;cửa hàng đó vào phạm vi của mình." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;dashed=1;align=left;spacingLeft=8;fontFamily=Times New Roman;fontSize=12;fontColor=#2D7600;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="60" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e7" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#82B366;" edge="1" parent="1" source="note3" target="active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
