        <mxCell id="nm" value="Bản đồ rút gọn, chỉ để thấy bảng nào nối với bảng nào.&#10;Cột chi tiết xem Hình 3.7a và Hình 3.7b." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;fontFamily=Times New Roman;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
